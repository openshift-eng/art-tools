FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS frontend
USER 0
WORKDIR /opt/app-root/src
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM registry.access.redhat.com/ubi9/python-312:latest
USER 0
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend/pipeline_ui/ /app/pipeline_ui/
COPY --from=frontend /opt/app-root/src/dist/ /app/static/
RUN chgrp -R 0 /app && chmod -R g=u /app
USER 1001
ENV STATIC_DIR=/app/static
EXPOSE 8080
CMD ["uvicorn", "pipeline_ui.app:app", "--host", "127.0.0.1", "--port", "8080", "--no-access-log"]
